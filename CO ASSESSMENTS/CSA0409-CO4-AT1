3. FCFS, SSTF, and SCAN Disk Scheduling
C Program
#include <stdio.h>
#include <stdlib.h>

#define MAX 100

void printSequence(int a[], int n)
{
    int i;
    for (i = 0; i < n; i++)
        printf("%d ", a[i]);
    printf("\n");
}

void fcfs(int q[], int n, int head)
{
    int i, movement = 0, current = head;
    int seq[MAX];

    for (i = 0; i < n; i++)
    {
        movement += abs(current - q[i]);
        current = q[i];
        seq[i] = q[i];
    }

    printf("\nFCFS\n");
    printf("Seek sequence: ");
    printSequence(seq, n);
    printf("Total seek time: %d\n", movement);
}

void sstf(int q[], int n, int head)
{
    int visited[MAX] = {0};
    int seq[MAX];
    int i, j, movement = 0;
    int current = head;
    int nearest, distance, minDistance;

    for (i = 0; i < n; i++)
    {
        nearest = -1;
        minDistance = 1000000;

        for (j = 0; j < n; j++)
        {
            if (!visited[j])
            {
                distance = abs(current - q[j]);

                if (distance < minDistance)
                {
                    minDistance = distance;
                    nearest = j;
                }
            }
        }

        visited[nearest] = 1;
        movement += minDistance;
        current = q[nearest];
        seq[i] = current;
    }

    printf("\nSSTF\n");
    printf("Seek sequence: ");
    printSequence(seq, n);
    printf("Total seek time: %d\n", movement);
}

void scan(int q[], int n, int head, int diskSize)
{
    int left[MAX], right[MAX];
    int l = 0, r = 0;
    int seq[MAX + 1];
    int count = 0;
    int i, j, temp;
    int movement = 0, current = head;

    for (i = 0; i < n; i++)
    {
        if (q[i] < head)
            left[l++] = q[i];
        else
            right[r++] = q[i];
    }

    for (i = 0; i < l - 1; i++)
        for (j = 0; j < l - i - 1; j++)
            if (left[j] < left[j + 1])
            {
                temp = left[j];
                left[j] = left[j + 1];
                left[j + 1] = temp;
            }

    for (i = 0; i < r - 1; i++)
        for (j = 0; j < r - i - 1; j++)
            if (right[j] > right[j + 1])
            {
                temp = right[j];
                right[j] = right[j + 1];
                right[j + 1] = temp;
            }

    for (i = 0; i < r; i++)
    {
        movement += abs(current - right[i]);
        current = right[i];
        seq[count++] = current;
    }

    if (current != diskSize - 1)
    {
        movement += abs(current - (diskSize - 1));
        current = diskSize - 1;
        seq[count++] = current;
    }

    for (i = 0; i < l; i++)
    {
        movement += abs(current - left[i]);
        current = left[i];
        seq[count++] = current;
    }

    printf("\nSCAN (initial direction: right)\n");
    printf("Seek sequence: ");
    printSequence(seq, count);
    printf("Total seek time: %d\n", movement);
}

int main()
{
    int q[MAX];
    int n, head, diskSize;
    int i;

    printf("Enter number of disk requests: ");
    scanf("%d", &n);

    printf("Enter request queue:\n");
    for (i = 0; i < n; i++)
        scanf("%d", &q[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("Enter disk size: ");
    scanf("%d", &diskSize);

    fcfs(q, n, head);
    sstf(q, n, head);
    scan(q, n, head, diskSize);

    printf("\nComparison: The algorithm with the smallest total seek time performs best.\n");

    return 0;
}
Input:
Request queue: 98 183 37 122 14 124 65 67
Initial head: 53
Disk size: 200
Output:
FCFS seek sequence: 98 183 37 122 14 124 65 67
SSTF and SCAN sequences are displayed with their total seek times.

4. C-SCAN and LOOK Disk Scheduling
C Program
#include <stdio.h>
#include <stdlib.h>

#define MAX 100

void printSequence(int seq[], int n)
{
    int i;
    for (i = 0; i < n; i++)
        printf("%d ", seq[i]);
    printf("\n");
}

void cscan(int q[], int n, int head, int diskSize, char direction)
{
    int left[MAX], right[MAX];
    int l = 0, r = 0;
    int seq[MAX + 2];
    int count = 0;
    int movement = 0, current = head;
    int i, j, temp;

    for (i = 0; i < n; i++)
    {
        if (q[i] < head)
            left[l++] = q[i];
        else
            right[r++] = q[i];
    }

    for (i = 0; i < r - 1; i++)
        for (j = 0; j < r - i - 1; j++)
            if (right[j] > right[j + 1])
            {
                temp = right[j];
                right[j] = right[j + 1];
                right[j + 1] = temp;
            }

    for (i = 0; i < l - 1; i++)
        for (j = 0; j < l - i - 1; j++)
            if (left[j] > left[j + 1])
            {
                temp = left[j];
                left[j] = left[j + 1];
                left[j + 1] = temp;
            }

    if (direction == 'R' || direction == 'r')
    {
        for (i = 0; i < r; i++)
        {
            movement += abs(current - right[i]);
            current = right[i];
            seq[count++] = current;
        }

        movement += abs(current - (diskSize - 1));
        current = diskSize - 1;
        seq[count++] = current;

        movement += diskSize - 1;
        current = 0;
        seq[count++] = current;

        for (i = 0; i < l; i++)
        {
            movement += abs(current - left[i]);
            current = left[i];
            seq[count++] = current;
        }
    }
    else
    {
        for (i = l - 1; i >= 0; i--)
        {
            movement += abs(current - left[i]);
            current = left[i];
            seq[count++] = current;
        }

        movement += current;
        current = 0;
        seq[count++] = current;

        movement += diskSize - 1;
        current = diskSize - 1;
        seq[count++] = current;

        for (i = r - 1; i >= 0; i--)
        {
            movement += abs(current - right[i]);
            current = right[i];
            seq[count++] = current;
        }
    }

    printf("\nC-SCAN\n");
    printf("Seek sequence: ");
    printSequence(seq, count);
    printf("Total head movement: %d\n", movement);
}

void look(int q[], int n, int head, char direction)
{
    int left[MAX], right[MAX];
    int l = 0, r = 0;
    int seq[MAX];
    int count = 0;
    int movement = 0, current = head;
    int i, j, temp;

    for (i = 0; i < n; i++)
    {
        if (q[i] < head)
            left[l++] = q[i];
        else
            right[r++] = q[i];
    }

    for (i = 0; i < r - 1; i++)
        for (j = 0; j < r - i - 1; j++)
            if (right[j] > right[j + 1])
            {
                temp = right[j];
                right[j] = right[j + 1];
                right[j + 1] = temp;
            }

    for (i = 0; i < l - 1; i++)
        for (j = 0; j < l - i - 1; j++)
            if (left[j] < left[j + 1])
            {
                temp = left[j];
                left[j] = left[j + 1];
                left[j + 1] = temp;
            }

    if (direction == 'R' || direction == 'r')
    {
        for (i = 0; i < r; i++)
        {
            movement += abs(current - right[i]);
            current = right[i];
            seq[count++] = current;
        }

        for (i = 0; i < l; i++)
        {
            movement += abs(current - left[i]);
            current = left[i];
            seq[count++] = current;
        }
    }
    else
    {
        for (i = 0; i < l; i++)
        {
            movement += abs(current - left[i]);
            current = left[i];
            seq[count++] = current;
        }

        for (i = 0; i < r; i++)
        {
            movement += abs(current - right[i]);
            current = right[i];
            seq[count++] = current;
        }
    }

    printf("\nLOOK\n");
    printf("Seek sequence: ");
    printSequence(seq, count);
    printf("Total head movement: %d\n", movement);
}

int main()
{
    int q[MAX];
    int n, head, diskSize;
    char direction;
    int i;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter request queue:\n");
    for (i = 0; i < n; i++)
        scanf("%d", &q[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("Enter disk size: ");
    scanf("%d", &diskSize);

    printf("Enter direction (L/R): ");
    scanf(" %c", &direction);

    cscan(q, n, head, diskSize, direction);
    look(q, n, head, direction);

    printf("\nConclusion: LOOK generally reduces unnecessary head movement because it reverses at the last pending request instead of travelling to the physical disk end.\n");

    return 0;
}
