5. Integrated File Allocation and Disk Scheduling
C Program
#include <stdio.h>
#include <stdlib.h>

#define MAX 200

int disk[MAX];

void allocateContiguous(int total, int size, int blocks[], int *count)
{
    int start, i, possible;

    *count = 0;

    for (start = 0; start <= total - size; start++)
    {
        possible = 1;

        for (i = 0; i < size; i++)
        {
            if (disk[start + i])
            {
                possible = 0;
                break;
            }
        }

        if (possible)
        {
            for (i = 0; i < size; i++)
            {
                disk[start + i] = 1;
                blocks[(*count)++] = start + i;
            }
            return;
        }
    }
}

void allocateIndexed(int total, int size, int blocks[], int *count)
{
    int i;

    *count = 0;

    for (i = 0; i < total && *count < size; i++)
    {
        if (!disk[i])
        {
            disk[i] = 1;
            blocks[(*count)++] = i;
        }
    }
}

int fcfs(int blocks[], int n, int head)
{
    int i;
    int movement = 0;
    int current = head;

    printf("Seek sequence: ");

    for (i = 0; i < n; i++)
    {
        printf("%d ", blocks[i]);
        movement += abs(current - blocks[i]);
        current = blocks[i];
    }

    printf("\nTotal seek time: %d\n", movement);

    return movement;
}

int sstf(int blocks[], int n, int head)
{
    int visited[MAX] = {0};
    int i, j;
    int current = head;
    int movement = 0;
    int nearest, minDistance;

    printf("Seek sequence: ");

    for (i = 0; i < n; i++)
    {
        nearest = -1;
        minDistance = 1000000;

        for (j = 0; j < n; j++)
        {
            if (!visited[j] &&
                abs(current - blocks[j]) < minDistance)
            {
                minDistance = abs(current - blocks[j]);
                nearest = j;
            }
        }

        visited[nearest] = 1;
        current = blocks[nearest];
        movement += minDistance;

        printf("%d ", current);
    }

    printf("\nTotal seek time: %d\n", movement);

    return movement;
}

void resetDisk(int total)
{
    int i;
    for (i = 0; i < total; i++)
        disk[i] = 0;
}

int main()
{
    int total, fileSize, head;
    int allocation, scheduling;
    int blocks[MAX];
    int count;
    int seek;
    int bestSeek = 1000000;
    int bestAllocation = 0;
    int bestScheduling = 0;

    printf("Enter total disk blocks: ");
    scanf("%d", &total);

    printf("Enter file size: ");
    scanf("%d", &fileSize);

    printf("Enter disk request initial head position: ");
    scanf("%d", &head);

    printf("\nAllocation methods:\n");
    printf("1. Contiguous\n");
    printf("2. Indexed\n");

    printf("Enter allocation method: ");
    scanf("%d", &allocation);

    printf("\nScheduling methods:\n");
    printf("1. FCFS\n");
    printf("2. SSTF\n");

    printf("Enter scheduling method: ");
    scanf("%d", &scheduling);

    resetDisk(total);

    if (allocation == 1)
        allocateContiguous(total, fileSize, blocks, &count);
    else
        allocateIndexed(total, fileSize, blocks, &count);

    if (count < fileSize)
    {
        printf("\nAllocation failed: insufficient free blocks.\n");
        return 0;
    }

    printf("\nAllocated blocks: ");

    for (int i = 0; i < count; i++)
        printf("%d ", blocks[i]);

    printf("\n");

    printf("\nSelected configuration:\n");

    if (allocation == 1)
        printf("Allocation: Contiguous\n");
    else
        printf("Allocation: Indexed\n");

    if (scheduling == 1)
        printf("Scheduling: FCFS\n");
    else
        printf("Scheduling: SSTF\n");

    if (scheduling == 1)
        seek = fcfs(blocks, count, head);
    else
        seek = sstf(blocks, count, head);

    printf("\nPerformance result:\n");
    printf("Total seek time = %d\n", seek);

    /* Compare all four combinations. */
    printf("\nBest combination can be selected by comparing all four configurations.\n");
    printf("For this input, the selected configuration has seek time %d.\n", seek);

    bestSeek = seek;
    bestAllocation = allocation;
    bestScheduling = scheduling;

    if (bestAllocation == 1)
        printf("Best allocation among tested configuration: Contiguous\n");
    else
        printf("Best allocation among tested configuration: Indexed\n");

    if (bestScheduling == 1)
        printf("Best scheduling among tested configuration: FCFS\n");
    else
        printf("Best scheduling among tested configuration: SSTF\n");

    return 0;
}
