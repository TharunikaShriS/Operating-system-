1. Simulation of Contiguous, Linked, and Indexed File Allocation
C Program
#include <stdio.h>

#define MAX 1000

int disk[MAX];

void displayBlocks(int blocks[], int n)
{
    int i;
    printf("Allocated blocks: ");
    for (i = 0; i < n; i++)
        printf("%d ", blocks[i]);
    printf("\n");
}

int main()
{
    int total, fileSize, method;
    int i, j, start, found;
    int blocks[MAX];

    printf("Enter total number of disk blocks: ");
    scanf("%d", &total);

    printf("Enter file size (number of blocks): ");
    scanf("%d", &fileSize);

    printf("Enter allocation method:\n");
    printf("1. Contiguous\n");
    printf("2. Linked\n");
    printf("3. Indexed\n");
    printf("Enter choice: ");
    scanf("%d", &method);

    if (total > MAX || fileSize > total || fileSize <= 0)
    {
        printf("Invalid disk/file size.\n");
        return 0;
    }

    for (i = 0; i < total; i++)
        disk[i] = 0;

    if (method == 1)
    {
        found = 0;

        for (start = 0; start <= total - fileSize; start++)
        {
            found = 1;

            for (j = 0; j < fileSize; j++)
            {
                if (disk[start + j] != 0)
                {
                    found = 0;
                    break;
                }
            }

            if (found)
                break;
        }

        if (!found)
        {
            printf("Contiguous allocation failed.\n");
            printf("Reason: No sufficient continuous free space.\n");
            return 0;
        }

        for (j = 0; j < fileSize; j++)
        {
            disk[start + j] = 1;
            blocks[j] = start + j;
        }

        printf("\nContiguous Allocation\n");
        displayBlocks(blocks, fileSize);
    }
    else if (method == 2)
    {
        j = 0;

        for (i = 0; i < total && j < fileSize; i++)
        {
            if (disk[i] == 0)
            {
                disk[i] = 1;
                blocks[j++] = i;
            }
        }

        if (j < fileSize)
        {
            printf("Linked allocation failed.\n");
            return 0;
        }

        printf("\nLinked Allocation\n");
        printf("Linked block sequence: ");
        for (i = 0; i < fileSize; i++)
        {
            printf("%d", blocks[i]);
            if (i < fileSize - 1)
                printf(" -> ");
        }
        printf("\n");
    }
    else if (method == 3)
    {
        j = 0;

        for (i = 0; i < total && j < fileSize; i++)
        {
            if (disk[i] == 0)
            {
                disk[i] = 1;
                blocks[j++] = i;
            }
        }

        if (j < fileSize)
        {
            printf("Indexed allocation failed.\n");
            return 0;
        }

        printf("\nIndexed Allocation\n");
        printf("Index block: %d\n", blocks[0]);

        printf("Data blocks: ");
        for (i = 1; i < fileSize; i++)
            printf("%d ", blocks[i]);

        printf("\n");
    }
    else
    {
        printf("Invalid allocation method.\n");
    }

    return 0;
}
Input:
Total blocks: 20
File size: 5
Method: 1
Output:
Contiguous Allocation
Allocated blocks: 0 1 2 3 4

